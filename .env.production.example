# ─────────────────────────────────────────────────────────────────────────────
#  Production Environment Configuration — Entrustic Beauty
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Public URL of the single origin (or separate frontend if deployed decoupled)
PUBLIC_ORIGIN=https://entrustic-beauty.vercel.app
CORS_ALLOWED_ORIGINS=https://entrustic-beauty.vercel.app
BASE_DOMAIN=entrustic-beauty.vercel.app

# Database Connection (Neon / AWS RDS / Self-hosted PostgreSQL)
DATABASE_HOST=ep-example.eu-central-1.aws.neon.tech
DATABASE_PORT=5432
DATABASE_USER=beauty_user
DATABASE_PASSWORD=SuperSecretPassword123!
DATABASE_NAME=beauty_clinic_db
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false

# JWT Security
JWT_SECRET=production-ultra-secure-jwt-secret-key-replace-me-2026
JWT_ACCESS_SECRET=production-ultra-secure-access-secret-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=production-ultra-secure-refresh-secret-2026
JWT_REFRESH_EXPIRES_IN=7d

# Tenant & Seed Defaults
SEED_CLINIC_SLUG=demo
SEED_CLINIC_NAME=Entrustic Beauty
SEED_CLINIC_WELCOME=مرحباً بكم في Entrustic Beauty
SEED_ADMIN_EMAIL=admin@yourplatform.com
SEED_ADMIN_PASSWORD=ChangeMe#Admin2026!
SEED_CLINIC_OWNER_EMAIL=owner@demo.yourplatform.com
SEED_CLINIC_OWNER_PASSWORD=Demo#Owner2026!
