# ==============================================================================
# Clinic Management Platform — Development Environment Configuration
# ==============================================================================

# Application
PORT=3001
NODE_ENV=development
BASE_DOMAIN=yourplatform.com

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=clinic_platform_dev
DATABASE_SYNCHRONIZE=false

# Authentication (Argon2id + JWT)
JWT_SECRET=dev-jwt-access-secret-32-chars-minimum-key!
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-32-chars-minimum-key!
JWT_REFRESH_EXPIRY=7d

# Rate Limiting (Throttler)
THROTTLE_TTL_SHORT=10000
THROTTLE_LIMIT_SHORT=20
THROTTLE_TTL_MEDIUM=60000
THROTTLE_LIMIT_MEDIUM=100

# Object Storage (S3 / MinIO / DigitalOcean Spaces)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=clinic-platform-dev
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_ENDPOINT=http://localhost:9000

# Redis Cache & Throttler
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Seed Script Configuration (Optional overrides)
SEED_ADMIN_EMAIL=admin@yourplatform.com
SEED_ADMIN_PASSWORD=ChangeMe#Admin2026!
SEED_CLINIC_OWNER_EMAIL=owner@demo.yourplatform.com
SEED_CLINIC_OWNER_PASSWORD=Demo#Owner2026!

# ── Derma & Skin Care Center (dermatology): run several programs side by side ──
# API_PORT=3001        # docker host port for the API
# WEB_HTTP_PORT=80     # docker host port for HTTP
# WEB_HTTPS_PORT=443   # docker host port for HTTPS
# REDIS_HOST_PORT=6379 # docker host port for Redis
# (DATABASE_PORT already exists above — raise it to avoid PG collisions)
